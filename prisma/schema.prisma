generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Category {
  VEGETABLES
  GRAINS
}

model Product {
  id              String    @id @default(cuid())
  name            String
  category        Category  @default(VEGETABLES)
  variety         String?
  description     String?
  characteristics String?
  price           String?
  minOrder        String?
  images          String[]  @default([])
  imageUrl        String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("products")
}

model Inquiry {
  id            String   @id @default(cuid())
  applicantType String
  companyName   String?
  contactPerson String
  phone         String
  email         String
  interestedIn  String[]
  volume        String?
  message       String?
  createdAt     DateTime @default(now())

  @@map("inquiries")
}

model SectionInfo {
  id          String   @id @default(cuid())
  title       String
  description String
  images      String[] @default([])
  icon        String   @default("🌱")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  link        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("section_info")
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("site_content")
}
model ProductOption {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("product_options")
}
